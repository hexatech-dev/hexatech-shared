{
  "name": "@hexatech-dev/shared",
  "version": "0.3.1",
  "description": "Shared DB client, Supabase auth, and email-sending helpers for Hexatech products",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "default": "./dist/auth.js"
    },
    "./email": {
      "types": "./dist/email.d.ts",
      "default": "./dist/email.js"
    },
    "./contact": {
      "types": "./dist/contact.d.ts",
      "default": "./dist/contact.js"
    },
    "./auth-client": {
      "types": "./dist/auth-client.d.ts",
      "default": "./dist/auth-client.js"
    },
    "./storage-apk": {
      "types": "./dist/storage-apk.d.ts",
      "default": "./dist/storage-apk.js"
    },
    "./storage-upload": {
      "types": "./dist/storage-upload.d.ts",
      "default": "./dist/storage-upload.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "check": "tsc --noEmit"
  },
  "peerDependencies": {
    "@neondatabase/serverless": "^1.1.0 || ^0.10.0",
    "@supabase/supabase-js": "^2.100.0",
    "drizzle-orm": "^0.39.0 || ^0.45.0",
    "express": "^4.0.0 || ^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "resend": "^6.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@supabase/supabase-js": "^2.105.4",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "pg": "^8.20.0",
    "resend": "^6.18.1",
    "typescript": "^5.9.0",
    "ws": "^8.20.0"
  }
}
